{
  "name": "dsh-wechat-clawbot",
  "version": "0.2.1",
  "description": "DSH bundle: WeChat floating-ball bridge (QR login, message relay, ClawBot model config) — maintained fork of lubaiUwU/DSH-WeChatClawBot",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dsh-client-wechat-ui/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-wechat-bot",
    "dsh-client-wechat-ui",
    "dsh-wechat-bridge",
    "wechat-gateway",
    "install-wechat.sh",
    "install-wechat.ps1",
    "install-dsh-bridge.sh",
    "scripts/lib.sh",
    "scripts/prepare.mjs",
    "scripts/link-peer-shims.mjs",
    "scripts/portability.mjs",
    "PORTABILITY-SOP.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.zh.md",
    "scripts/release.mjs"
  ],
  "scripts": {
    "test": "node --test dsh-wechat-bot/keepalive.test.mjs wechat-gateway/window.test.mjs",
    "verify": "node scripts/portability.mjs --health /api/dsh-wechat-bot/probe",
    "verify:full": "node scripts/portability.mjs --health /api/dsh-wechat-bot/probe --stability 30",
    "verify:quick": "node scripts/portability.mjs --skip-audit --stability 5 --health /api/dsh-wechat-bot/probe",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "ilink"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengjy01/dsh-wechat-clawbot.git"
  },
  "homepage": "https://github.com/zhengjy01/dsh-wechat-clawbot",
  "bugs": {
    "url": "https://github.com/zhengjy01/dsh-wechat-clawbot/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  }
}
